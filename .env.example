# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored; this file is committed, so keep it placeholders only.

# Upstash Redis (Vercel > Storage > Upstash, or console.upstash.com)
UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxx"

# 32+ char random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Used only by `npm run seed` — the account that receives the starter recipes.
SEED_EMAIL="you@example.com"
SEED_PASSWORD="a-password-you-will-remember"
